<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 11 o inferior -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Android 12 o superior: conectarse a equipos ya vinculados -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <!-- allowBackup="false": el PIN cifrado no se copia en los respaldos del teléfono -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InterruptorBT"
        tools:targetApi="31">

        <!-- Primera pantalla: PIN. Es la única que se puede abrir desde fuera de la app. -->
        <activity
            android:name=".PinActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- exported="false": solo se llega a estas pantallas después de ingresar el PIN -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".PuenteActivity"
            android:exported="false" />
        <activity
            android:name=".ControlActivity"
            android:exported="false" />
    </application>

</manifest>
